# Supabase — copy to .env.local and fill in. Also set these in the Vercel project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Bypasses Row Level Security. Never expose to the browser,
# never commit. Used only by lib/supabase-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL for building auth redirect links (magic link, Google OAuth, email
# confirmation). Local: http://localhost:3000. Vercel: the deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Extraction worker (Phase 3) ---

# Anthropic API key for document extraction (server-only secret).
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for the /api/extraction database webhook. Generate a random
# value and store the SAME value in the Supabase Vault secret
# `extraction_webhook_secret` (see supabase/migrations/*_documents_extraction_webhook.sql).
EXTRACTION_WEBHOOK_SECRET=change-me

# Optional: comma-separated emails allowed to open /internal/* pages.
# Leave unset to allow any signed-in user.
INTERNAL_TOOLS_EMAILS=

# --- Reminders ---

# Resend API key for reminder email (server-only secret). Unset = reminders are
# scheduled and logged as skipped, but nothing is actually sent.
RESEND_API_KEY=re_...

# The From: address reminder email is sent from. Must be on a domain verified
# in Resend, e.g. "homeapp <reminders@yourdomain.com>".
REMINDERS_FROM_EMAIL=reminders@example.com

# Shared secret for the daily /api/cron/reminders job. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>` automatically once the variable is set
# in the project; generate a long random value.
CRON_SECRET=change-me

# --- Billing (Stripe) ---
#
# Leave every STRIPE_* variable unset to run without billing: the plan card
# says billing isn't set up, the paid gates stay inert (every household keeps
# export and unlimited reminders) and the webhook no-ops.

# Stripe secret key (server-only secret). Setting this is what turns billing
# on, so set the prices below at the same time.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for POST /api/stripe/webhook. From the Stripe dashboard
# endpoint, or from `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for the four options. UK households are offered the GBP prices,
# US households the USD ones (£4.99/mo, £39/yr, $6.99/mo, $59/yr).
STRIPE_PRICE_GBP_MONTHLY=price_...
STRIPE_PRICE_GBP_YEARLY=price_...
STRIPE_PRICE_USD_MONTHLY=price_...
STRIPE_PRICE_USD_YEARLY=price_...

# --- Address lookup (optional) ---
#
# Ideal Postcodes API key for UK postcode → address picker on home &
# school forms. Unset = fall back to free postcodes.io (postcode validation /
# area only, no full address list).
# Sign up: https://account.ideal-postcodes.co.uk/users/sign_up
# Public test key ak_test works for a few lookups/day.
IDEAL_POSTCODES_API_KEY=
