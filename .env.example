# Supabase — copy to .env.local and fill in. Also set these in the Vercel project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret. Bypasses Row Level Security. Never expose to the browser,
# never commit. Used only by lib/supabase-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL for building auth redirect links (magic link, Google OAuth, email
# confirmation). Local: http://localhost:3000. Vercel: the deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Extraction worker (Phase 3) ---

# Anthropic API key for document extraction (server-only secret).
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for the /api/extraction database webhook. Generate a random
# value and store the SAME value in the Supabase Vault secret
# `extraction_webhook_secret` (see supabase/migrations/*_documents_extraction_webhook.sql).
EXTRACTION_WEBHOOK_SECRET=change-me

# Optional: comma-separated emails allowed to open /internal/* pages.
# Leave unset to allow any signed-in user.
INTERNAL_TOOLS_EMAILS=

# --- Reminders ---

# Resend API key for reminder email (server-only secret). Unset = reminders are
# scheduled and logged as skipped, but nothing is actually sent.
RESEND_API_KEY=re_...

# The From: address reminder email is sent from. Must be on a domain verified
# in Resend, e.g. "Hearth <reminders@yourdomain.com>".
REMINDERS_FROM_EMAIL=reminders@example.com

# Shared secret for the daily /api/cron/reminders job. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>` automatically once the variable is set
# in the project; generate a long random value.
CRON_SECRET=change-me

# --- Gmail import (optional) ---
#
# Separate from Supabase Auth Google sign-in. Create a Web application OAuth
# client, enable Gmail API, and register:
#   http://localhost:3000/api/gmail/callback
#   https://homeapp-mu.vercel.app/api/gmail/callback
# Scope requested: https://www.googleapis.com/auth/gmail.readonly
#
# Unset = Add document sheet still works; Gmail connect shows a setup message.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (Stripe) ---
#
# Leave every STRIPE_* variable unset to run without billing: the plan card
# says billing isn't set up, the paid gates stay inert (every household keeps
# export and unlimited reminders) and the webhook no-ops.

# Stripe secret key (server-only secret). Setting this is what turns billing
# on, so set the prices below at the same time.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for POST /api/stripe/webhook. From the Stripe dashboard
# endpoint, or from `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for the four options. UK households are offered the GBP prices,
# US households the USD ones (£4.99/mo, £39/yr, $6.99/mo, $59/yr).
STRIPE_PRICE_GBP_MONTHLY=price_...
STRIPE_PRICE_GBP_YEARLY=price_...
STRIPE_PRICE_USD_MONTHLY=price_...
STRIPE_PRICE_USD_YEARLY=price_...

# --- Address lookup (optional) ---
#
# Ideal Postcodes API key for UK postcode → address picker on home &
# school forms. Unset = fall back to free postcodes.io (postcode validation /
# area only, no full address list).
# Sign up: https://account.ideal-postcodes.co.uk/users/sign_up
# Public test key ak_test works for a few lookups/day.
#
# Budget note: /api/address-lookup is signed-in only, rate-limited per user
# (~20/min) and caches each normalised postcode for ~10 minutes in-process.
# Still meter the Ideal dashboard — serverless isolates each have their own
# cache, so traffic across many instances can multiply lookups.
IDEAL_POSTCODES_API_KEY=

# --- Home map underlay (optional) ---
#
# Dedicated HMAC secret for short-lived /api/home-map tokens minted by
# resolveHomeMap. Do NOT reuse SUPABASE_SERVICE_ROLE_KEY or the anon key.
# Unset = tokens are not minted; /api/home-map still works for signed-in
# sessions (hero underlay stays available when logged in).
# Generate e.g. `openssl rand -base64 32` and set the same value on Vercel.
HOME_MAP_SIGNING_SECRET=

# --- Home map tiles (CARTO) ---
#
# CARTO Voyager raster tiles now require a free API key. Without it, tiles
# arrive stamped "API KEY REQUIRED". Request a key (emailed instantly, no
# account queue): https://carto.com/basemaps/apikey/
# Then set the same value on Vercel (Production + Preview). Server-only —
# never NEXT_PUBLIC_*. Until set, /api/home-map falls back to OSM tiles.
CARTO_BASEMAPS_API_KEY=


# --- App Store subscriptions (iPhone app, StoreKit 2) ---
#
# The iPhone app sells "Hearth Household" through Apple. The server verifies
# everything Apple signs (transactions from the app, App Store Server
# Notifications) against Apple Root CA - G3, in both Production and Sandbox —
# TestFlight and App Review purchases are Sandbox and reach this server too.
# None of these four values is a secret.
#
# The app's numeric Apple ID (App Store Connect > App Information > Apple ID).
# Setting it switches App Store billing ON: Production purchases start to
# verify, and — like STRIPE_SECRET_KEY — it arms the paid gates (export).
# Unset = only Sandbox data verifies and, if Stripe is unset too, every
# household keeps the paid features.
APPSTORE_APP_APPLE_ID=

# Bundle id the signed data must carry. Default: co.rodor.homeapp
APPSTORE_BUNDLE_ID=

# Comma-separated product ids that grant the plan. Default:
# co.rodor.homeapp.household.monthly,co.rodor.homeapp.household.yearly
APPSTORE_PRODUCT_IDS=

# OCSP revocation checks on Apple's signing certificates. On unless set to
# "false" (only turn off if Apple's OCSP responder is unreachable from Vercel).
APPSTORE_ONLINE_CHECKS=

# In App Store Connect > App Information > App Store Server Notifications, set
# BOTH the Production and Sandbox URL (Version 2) to:
#   https://<your-domain>/api/appstore/notifications

# --- Sign in with Apple (iPhone app) ---
#
# Sign-in itself is verified by Supabase (enable the Apple provider and add the
# bundle id co.rodor.homeapp to its Client IDs). These three are for the one
# thing Supabase does not do: revoking the Apple token when an account is
# deleted (App Review Guideline 5.1.1(v)). Server-only secrets — never commit.
#
# Apple Developer > Membership > Team ID.
APPLE_TEAM_ID=
# Apple Developer > Keys > a key with "Sign in with Apple" enabled > Key ID.
APPLE_SIWA_KEY_ID=
# The contents of that key's .p8 file. Paste with real newlines, or on one
# line with \n between lines.
APPLE_SIWA_PRIVATE_KEY=
# Client id the tokens are issued to. Default: the bundle id (correct for
# native sign-in). Only set if it ever differs.
APPLE_SIWA_CLIENT_ID=

# --- App Review demo account ---
#
# Email of the one account Apple's reviewer signs in with. That account — and
# only that account — is let past the paywall, decided on the server
# (lib/review-demo.ts). Unset = no demo account. Its password is never stored
# here or in code: it lives in Supabase Auth.
REVIEW_DEMO_EMAIL=
# Used ONLY by `node scripts/seed-review-demo.mjs` on your own machine to
# create the account. Do not set this on Vercel.
REVIEW_DEMO_PASSWORD=
